# Copy this file to the ignored scripts/project.env for local overrides.
CONTAINER_KIND="project"                 # project or workspace
CONTAINER_PATH="TiebaLite.xcodeproj"     # or .xcworkspace
SCHEME="TiebaLite"
TEST_PLAN="TiebaLite"
UNIT_TEST_PLAN_CONFIGURATION="Unit"
UI_SMOKE_TEST_PLAN_CONFIGURATION="UI Smoke"
FULL_TEST_PLAN_CONFIGURATION="Full"
UNIT_TEST_TARGET="TiebaLiteTests"
UI_TEST_TARGET="TiebaLiteUITests"
UI_SMOKE_TEST_IDENTIFIER="TiebaLiteUITests/LaunchSmokeTests/testLaunchShowsStablePlaceholder"
DERIVED_DATA_PATH=".build/DerivedData"
RESULTS_DIR="Artifacts/TestResults"
# Optional explicit simulator UDIDs. Leave empty to auto-select.
IPHONE_SIMULATOR_UDID=""
IPAD_SIMULATOR_UDID=""
